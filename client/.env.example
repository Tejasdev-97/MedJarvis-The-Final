# ============================
# Frontend Environment Variables
# ============================

# Backend API URL
# Local Development
VITE_API_URL=http://localhost:5000/api

# Google Cloud Translation API Key (Frontend Optional)
# Used for live dynamic fallback translation when local JSON key is not found
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_cloud_translation_api_key_here

# Example:
# VITE_API_URL=https://your-backend-url/api
# VITE_GOOGLE_TRANSLATE_API_KEY=AIzaSy...